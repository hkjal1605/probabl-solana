API_HOST=127.0.0.1
# Structured backend logs: debug, info, warn, error, silent. Keep info for normal operations.
LOG_LEVEL=info
API_PORT=3000
API_AUTH_DOMAIN=api.example.com
API_AUTH_ORIGIN=https://api.example.com
# Single authenticated operator for market creation, approval and resolution.
# Leave unset/empty to disable the admin API. Requires MARKET_ADMIN_ROLE onchain;
# final resolution additionally requires RESOLUTION_ADMIN_ROLE on this same wallet.
MARKET_ADMIN=
ADMIN_EVIDENCE_PUBLIC_BASE_URL=https://evidence.example.com/v1/attachments
ROBINHOOD_CHAIN_ID=46630
# For internal RH mainnet only, use 4663 and explicitly accept the deferred risks:
# DEPLOYMENT_MODE=internal-mainnet
# INTERNAL_MAINNET_RISK_ACK=I_ACCEPT_M02_AND_DEPENDENCY_RISK_FOR_INTERNAL_TESTING
ROBINHOOD_RPC_URL=https://replace-with-verified-testnet-rpc.example
ROBINHOOD_WS_URL=wss://replace-with-verified-testnet-websocket.example
DEPLOYMENT_BLOCK=0
INDEXER_CONFIRMATION_BLOCKS=2
INDEXER_FINALITY_BLOCKS=30
INDEXER_POLLING_INTERVAL_MS=1000
INDEXER_GET_LOGS_BLOCK_RANGE=2000
# Optional smooth per-indexer RPC ceiling. Leave headroom for API/reconciler on a shared key.
# For a 30-RPS endpoint, use 26; providers may also impose separate CU/log-range limits.
# INDEXER_RPC_MAX_RPS=26
# INDEXER_END_BLOCK is only for bounded replay verification.
# INDEXER_END_BLOCK=123456
INDEXER_DEPLOYMENT_MANIFEST=/absolute/path/to/generated-v2-manifest.json
DATABASE_SCHEMA=probabl_indexer_atomic_v2
# Required by ALL backend services, locally and in production. Same writer endpoint/database;
# credentials may differ by service. Never use a read replica for operational writes.
DATABASE_URL=postgresql://probabl_runtime:replace-password@host:5432/probabl?sslmode=verify-full
# Per service process (Ponder has a separate total pool budget below).
DATABASE_POOL_SIZE=10
# Run bun run db:migrate with a migration-owner DATABASE_URL before starting services.
# TEST_DATABASE_URL is only for an isolated LOOPBACK PostgreSQL test server, never production.
INDEXER_FINALITY_MODE=rpc-tags
INDEXER_CONFIRMATION_MODE=safe
INDEXER_MAX_HEAD_AGE_SECONDS=30
PONDER_DATABASE_POOL_SIZE=10
# Retain recent block anchors in a fixed-size ring; older anchors use verified RPC reads.
# Changing INDEXER_BLOCK_RETENTION requires a fresh projection schema/replay.
INDEXER_BLOCK_RETENTION=8192
# Disposable per-deployment cache: keep this many blocks BEFORE the safe recovery checkpoint.
# Finality/recovery lag adds to the retained window; never prune unfinalized recovery state.
INDEXER_CACHE_RETENTION=8192
INDEXER_CACHE_MAINTENANCE_INTERVAL_MS=15000
INDEXER_CACHE_MAINTENANCE_BATCH_SIZE=2000
# Leave PONDER_DISABLE_CACHE unset/false on RH. Bounded retention preserves recent cache reuse.
# PONDER_SYNC_SCHEMA is derived by the launcher; do not set it manually.
CONDITIONAL_TOKENS_ADDRESS=0x0000000000000000000000000000000000000000
MARKET_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
EXCHANGE_ADDRESS=0x0000000000000000000000000000000000000000
ATOMIC_ORDER_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
# Automatically created by ConditionalExchange; copy PayoutVault from its deployment manifest.
PAYOUT_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
PROTOCOL_AUTHORITY_ADDRESS=0x0000000000000000000000000000000000000000
SETTLEMENT_ADDRESS=0x0000000000000000000000000000000000000000
POSITION_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
RESOLUTION_CONTROLLER_ADDRESS=0x0000000000000000000000000000000000000000
ORDER_RECOVERY_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
INDEXER_API_URL=http://127.0.0.1:42069
RECONCILIATION_EXCLUSIVE_CTF=true
RECONCILIATION_INTERVAL_MS=30000
RECONCILIATION_DEEP_INTERVAL_MS=86400000
RECONCILIATION_API_PORT=42070
RECONCILIATION_URL=http://127.0.0.1:42070
RECONCILIATION_MAX_AGE_MS=120000
RECONCILIATION_MAX_DEEP_AGE_MS=90000000
SAFETY_REQUEST_TIMEOUT_MS=5000
INDEXER_URL=http://127.0.0.1:42069
POLYMARKET_HOST=127.0.0.1
POLYMARKET_PORT=42073
POLYMARKET_INTERNAL_TOKEN=replace-with-a-different-long-random-service-token
POLYMARKET_INGESTOR_URL=http://127.0.0.1:42073
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_RECONCILE_MS=30000
POLYMARKET_METADATA_POLL_MS=300000
POLYMARKET_STALE_AFTER_MS=30000
# 100 USDC/USDC.e at six source decimals.
POLYMARKET_STANDARD_NOTIONAL_X6=100000000
