{
  "name": "@conditional-stocks/rh-indexer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "anvil:bootstrap": "bun scripts/bootstrap-anvil.ts",
    "anvil:start": "anvil --chain-id 31337 --block-time 2 --quiet",
    "codegen": "PONDER_ALLOW_PLACEHOLDERS=true bun --bun ponder codegen",
    "dev": "bun run preflight && bun scripts/ponder.ts dev",
    "dev:anvil": "bun --env-file=.env.anvil run preflight && bun --env-file=.env.anvil scripts/ponder.ts dev",
    "preflight": "bun scripts/preflight.ts",
    "reconcile": "bun scripts/reconcile.ts once --deep",
    "reconcile:anvil": "bun --env-file=.env.anvil scripts/reconcile.ts once --deep",
    "reconcile:continuous": "bun scripts/reconcile.ts watch",
    "resolve:anvil": "bun --env-file=.env.anvil scripts/resolve-anvil-market.ts",
    "seed:anvil": "bun --env-file=.env.anvil scripts/seed-anvil-orders.ts",
    "start": "bun run preflight && bun scripts/ponder.ts start",
    "serve": "bun scripts/ponder.ts serve",
    "test": "bun test tests",
    "typecheck": "bun run codegen && tsc --noEmit",
    "verify:rebuild": "bun scripts/verify-rebuild.ts"
  },
  "dependencies": {
    "@conditional-stocks/config": "workspace:*",
    "@conditional-stocks/contract-bindings": "workspace:*",
    "@conditional-stocks/domain": "workspace:*",
    "@conditional-stocks/orderbook": "workspace:*",
    "hono": "4.13.5",
    "ponder": "0.17.8",
    "viem": "2.56.3",
    "@conditional-stocks/db": "workspace:*",
    "@conditional-stocks/shared": "workspace:*"
  }
}
