# Copy to .env.devnet (ignored), chmod 600, then fill in locally. Never paste a
# key into chat, commit it, or reuse a wallet holding mainnet assets.
# Base58-encoded 64-byte Solana secret key OR JSON array of exactly 64 bytes.
DEVNET_DEPLOYER_PRIVATE_KEY=
DEVNET_RPC_URL=https://api.devnet.solana.com
# TPU/QUIC avoids bulk uploads through the public RPC's request limits.
# Set rpc only with a provider that permits the deployment upload request rate.
# rpc-paced is a slower, resumable fallback for public RPC rate limits.
DEVNET_UPLOAD_TRANSPORT=tpu
# This endpoint is intentionally public: NEXT_PUBLIC_* is visible in browsers.
DEVNET_BROWSER_RPC_URL=https://api.devnet.solana.com
DEVNET_OUTPUT_DIR=.local/devnet
# Must match Rust declare_id!, SDK and IDL. The first deploy needs this signer.
# Back this file up securely; don't regenerate it with `anchor keys sync`.
DEVNET_PROGRAM_KEYPAIR=target/deploy/conditional_stocks-keypair.json
# Shared devnet EC2 HTTPS origin. Use local SSH tunnel origins for private testing.
DEVNET_API_URL=https://api-solana.probabl.trade
DEVNET_INDEXER_URL=https://api-solana.probabl.trade
DEVNET_UI_ORIGINS=http://localhost:3001,http://localhost:3002
# API host only: separate, funded, non-admin fee-payer for trading-only grants.
# Never expose this key to the browser or reuse the deployer/market-maker key.
TRADING_DELEGATE_PRIVATE_KEY=
TRADING_DELEGATE_ADDRESS=
# Backend-only Yellowstone gRPC (Geyser) stream for the API and indexer live
# index: a devnet endpoint from Triton, Helius LaserStream or QuickNode.
DEVNET_YELLOWSTONE_GRPC_URL=
DEVNET_YELLOWSTONE_X_TOKEN=
# Operator-side DNS administration only; never copy this token to EC2 or a UI.
CLOUDFLARE_API_TOKEN=

# Backend-only display prices. Never expose either value through NEXT_PUBLIC_*.
JUPITER_API_KEY=
# Mainnet RPC solely for Jupiter pricing-block timestamps, even when trading on devnet.
JUPITER_PRICE_RPC_URL=https://api.mainnet-beta.solana.com

# Devnet API/indexer PostgreSQL. URL-encode the password (especially @ : / # $ %).
# Use the cluster's actual port; 5432 is PostgreSQL's default, not port 0.
# Set sslrootcert to an absolute certificate path on the machine running services.
DATABASE_URL="postgresql://postgres:REPLACE_WITH_URL_ENCODED_DB_PASSWORD@YOUR_DEVNET_RDS_ENDPOINT:5432/postgres?sslmode=verify-full&sslrootcert=/ABSOLUTE/PATH/TO/certs/rds-ap-northeast-1-bundle.pem"
