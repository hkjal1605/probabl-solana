API_URL=http://127.0.0.1:3000
# Public build-time setting; never put logging credentials in NEXT_PUBLIC_*.
NEXT_PUBLIC_LOG_LEVEL=info
INDEXER_URL=http://127.0.0.1:42069
# Optional health-only origin; defaults to INDEXER_URL. Set empty when it is private
# and unreachable from this UI server. Empty ingestor/reconciler URLs likewise disable probes.
# INDEXER_HEALTH_ORIGIN=
POLYMARKET_INGESTOR_URL=http://127.0.0.1:42073
RECONCILIATION_URL=http://127.0.0.1:42070
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=31337
NEXT_PUBLIC_ROBINHOOD_CHAIN_NAME=Robinhood Chain Local
NEXT_PUBLIC_ROBINHOOD_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_MARKET_REGISTRY_ADDRESS=
NEXT_PUBLIC_EXCHANGE_ADDRESS=
NEXT_PUBLIC_CONDITIONAL_TOKENS_ADDRESS=
# Public addresses only. When started with the root environment, next.config maps
# MARKET_ADMIN and RESOLUTION_CONTROLLER_ADDRESS to these public build-time values.
NEXT_PUBLIC_RESOLUTION_CONTROLLER_ADDRESS=
NEXT_PUBLIC_MARKET_ADMIN_ADDRESS=
# Polygon source evidence contract, not the local Robinhood Conditional Tokens deployment.
# Optional default: an operator can supply and verify this address in the resolution form.
NEXT_PUBLIC_POLYGON_CONDITIONAL_TOKENS_ADDRESS=
# The API itself requires MARKET_ADMIN, RESOLUTION_CONTROLLER_ADDRESS,
# ADMIN_EVIDENCE_PUBLIC_BASE_URL and ingestor credentials. No second operator is required.
# A local development UI still needs network access to API_URL and INDEXER_URL.
