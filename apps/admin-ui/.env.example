API_URL=https://api-solana.probabl.trade
# Public build-time setting; never put logging credentials in NEXT_PUBLIC_*.
NEXT_PUBLIC_LOG_LEVEL=info
INDEXER_URL=https://api-solana.probabl.trade
# The shared HTTPS origin exposes /indexer-health and /polymarket-health.
# Optional separate service origins use /health; an empty value disables a probe.
INDEXER_HEALTH_ORIGIN=https://api-solana.probabl.trade
POLYMARKET_INGESTOR_URL=https://api-solana.probabl.trade
# Reconciliation stays private; API /ready checks its readiness.
RECONCILIATION_URL=
# Copy to apps/admin-ui/.env.local for the deployed Devnet instance, then restart Next.
# Public values only. NEVER load .env.devnet or a wallet private key into this UI.
NEXT_PUBLIC_SOLANA_CLUSTER_NAME="Solana Devnet (mock assets)"
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_PROGRAM_ID=53gtyz9nYzS7vwSbx2v7GeGLrMTas7vCATkjiKvAG1ra
NEXT_PUBLIC_SOLANA_CONFIG=EfXom6mQxuw5gsHG4AujCgo1dQ3qWg5pN85RvY1ysn23
NEXT_PUBLIC_SOLANA_GENESIS_HASH=EtWTRABZaYq6iMfeYKouRu166VU2xqa1wcaWoxPkrZBG
# Display hints, not authorization. Live roles are read from the verified config account.
NEXT_PUBLIC_SOLANA_MARKET_ADMIN=4o2JYy6ktdZEfaUVHGwdCbvMyypZ1NRCDpyS1rfY9q8z
NEXT_PUBLIC_SOLANA_RESOLUTION_ADMIN=4o2JYy6ktdZEfaUVHGwdCbvMyypZ1NRCDpyS1rfY9q8z
# Polygon source evidence contract, not the Solana deployment.
# Optional default: an operator can supply and verify this address in the resolution form.
NEXT_PUBLIC_POLYGON_CONDITIONAL_TOKENS_ADDRESS=
# A local development UI still needs network access to API_URL and INDEXER_URL.
