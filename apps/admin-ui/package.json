{
  "name": "@conditional-stocks/admin-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "next build --webpack",
    "build:cloudflare": "PROBABL_REHEARSAL_BUILD=0 opennextjs-cloudflare build && bun scripts/cloudflare-sanitize.ts",
    "deploy:cloudflare": "bun run build:cloudflare && opennextjs-cloudflare deploy",
    "dryrun:cloudflare": "bun run build:cloudflare && OPEN_NEXT_DEPLOY=true wrangler deploy --dry-run",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "dev": "next dev -H 127.0.0.1 -p 3002",
    "lint": "biome check src test next.config.ts",
    "start": "next start -p 3002",
    "test": "bun test test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@conditional-stocks/domain": "workspace:*",
    "@conditional-stocks/market-data": "workspace:*",
    "@conditional-stocks/shared": "workspace:*",
    "@conditional-stocks/solana-client": "workspace:*",
    "@solana/web3.js": "1.98.4",
    "@tanstack/react-query": "5.101.4",
    "bs58": "6.0.0",
    "buffer": "6.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "next": "16.3.0",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.16.2",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@types/node": "26.4.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "wrangler": "4.129.1"
  }
}
