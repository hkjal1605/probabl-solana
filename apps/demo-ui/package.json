{
  "name": "@conditional-stocks/demo-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "next build --webpack",
    "dev": "next dev -H 127.0.0.1 -p 3002",
    "lint": "biome check src test scripts next.config.ts open-next.config.ts wrangler.jsonc",
    "start": "next start -p 3002",
    "typecheck": "tsc --noEmit",
    "test": "bun test test",
    "build:cloudflare": "opennextjs-cloudflare build && bun scripts/cloudflare-sanitize.ts",
    "preview:cloudflare": "bun run build:cloudflare && opennextjs-cloudflare preview",
    "dryrun:cloudflare": "bun run build:cloudflare && OPEN_NEXT_DEPLOY=true wrangler deploy --dry-run",
    "deploy:cloudflare": "bun run build:cloudflare && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@conditional-stocks/domain": "workspace:*",
    "@conditional-stocks/shared": "workspace:*",
    "@fontsource-variable/manrope": "5.3.0",
    "boring-avatars": "^2.0.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "1.31.0",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.3.0",
    "shadcn": "4.16.2",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.3.0",
    "happy-dom": "^20.14.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "wrangler": "4.129.1"
  }
}
