# Copy to .dev.vars for local Workers preview only (never deployed).
NEXTJS_ENV=development
# Runtime bindings are explicit: local .env files are NOT shipped in the Worker.
API_URL=https://api-solana.probabl.trade
INDEXER_URL=https://api-solana.probabl.trade
# Keep the same HTTPS-only validation as the deployed Worker.
# For an isolated local-validator rehearsal, explicitly set local service origins
# and PROBABL_HOSTING=local in your ignored .dev.vars instead.
PROBABL_HOSTING=cloudflare
