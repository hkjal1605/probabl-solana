# Copy to .dev.vars for local Workers preview only (never deployed).
NEXTJS_ENV=development
# Runtime bindings are explicit: local .env files are NOT shipped in the Worker.
API_URL=http://127.0.0.1:3000
INDEXER_URL=http://127.0.0.1:42069
# Permit the local API/indexer in workerd. The deployed Worker must keep the
# wrangler.jsonc value PROBABL_HOSTING=cloudflare and use HTTPS upstreams.
PROBABL_HOSTING=local
