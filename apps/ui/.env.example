API_URL=http://127.0.0.1:3000
# Public canonical UI origin (HTTPS for Workers); used for social metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3001
# For Cloudflare, see docs/runbooks/ui-cloudflare-workers.md. NEXT_PUBLIC_*
# values are embedded at BUILD time; API_URL/INDEXER_URL are Worker runtime vars.
# Public build-time setting; never put logging credentials in NEXT_PUBLIC_*.
NEXT_PUBLIC_LOG_LEVEL=info
INDEXER_URL=http://127.0.0.1:42069
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=31337
NEXT_PUBLIC_ROBINHOOD_CHAIN_NAME=Robinhood Chain Local
NEXT_PUBLIC_ROBINHOOD_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_BLOCK_EXPLORER_URL=
NEXT_PUBLIC_CONDITIONAL_TOKENS_ADDRESS=
NEXT_PUBLIC_EXCHANGE_ADDRESS=
NEXT_PUBLIC_ATOMIC_ORDER_ROUTER_ADDRESS=
NEXT_PUBLIC_PAYOUT_VAULT_ADDRESS=
NEXT_PUBLIC_POSITION_ROUTER_ADDRESS=
# Only real API/indexer responses are used. Legacy mode cookies and preview flags have no effect.
NEXT_PUBLIC_POLYMARKET_STREAM_URL=ws://127.0.0.1:42073
