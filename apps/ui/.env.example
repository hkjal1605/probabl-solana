API_URL=https://api-solana.probabl.trade
# Public origin for direct display-price requests. No provider API keys in the UI.
NEXT_PUBLIC_API_URL=https://api-solana.probabl.trade
# Public canonical UI origin (HTTPS for Workers); used for social metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3001
# NEXT_PUBLIC_* values are embedded at build time for Cloudflare Workers.
# values are embedded at BUILD time; API_URL/INDEXER_URL are Worker runtime vars.
# Public build-time setting; never put logging credentials in NEXT_PUBLIC_*.
NEXT_PUBLIC_LOG_LEVEL=info
INDEXER_URL=https://api-solana.probabl.trade
# Public Solana Devnet settings. The exact genesis hash enables the temporary
# deployed-test-mint metadata map. Use a browser-safe RPC credential, never a deployer key.
NEXT_PUBLIC_SOLANA_CLUSTER_NAME="Solana Devnet (mock assets)"
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_GENESIS_HASH=EtWTRABZaYq6iMfeYKouRu166VU2xqa1wcaWoxPkrZBG
NEXT_PUBLIC_SOLANA_PROGRAM_ID=8S7LwM6yRszZaAoEQqgE1AYcZJLpyVVC5MRr7vqCxLtg
NEXT_PUBLIC_SOLANA_CONFIG=6buYkVtSJjaoozCDsPFYrPhp5g1q1oLg2eLp7FpsZ1tF
NEXT_PUBLIC_SOLANA_EXPLORER_URL=https://explorer.solana.com
