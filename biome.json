{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.next",
      "!**/.next-rehearsal",
      "!**/.next-cloudflare",
      "!**/.open-next",
      "!**/.wrangler",
      "!**/cloudflare-env.d.ts",
      "!coverage",
      "!**/.playwright-cli",
      "!**/out",
      "!output",
      "!**/cache",
      "!**/broadcast",
      "!packages/contracts/lib",
      "!audit/2026-09-06/remediation/evidence",
      "!audit/2026-09-06/real-token-fork/evidence",
      "!audit/2026-09-06/raw-unit-ratio/evidence",
      "!audit/2026-09-07/internal-mainnet-readiness/evidence",
      "!audit/2026-09-07/indexer-storage/evidence",
      "!audit/2026-09-08/atomic-placement/real-token-evidence",
      "!audit/2026-09-06/repro",
      "!packages/contract-bindings/src/generated.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
