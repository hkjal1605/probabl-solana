EXPECTED_CHAIN_ID=46630
# RH mainnet internal testing only: set EXPECTED_CHAIN_ID=4663 and both values below.
# DEPLOYMENT_MODE=internal-mainnet
# INTERNAL_MAINNET_RISK_ACK=I_ACCEPT_M02_AND_DEPENDENCY_RISK_FOR_INTERNAL_TESTING
ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Never commit a real key. Prefer a hardware-backed deployment workflow.
DEPLOYER_PRIVATE_KEY=
# Temporary deployment administrator; must equal DEPLOYER_PRIVATE_KEY's address.
INITIAL_ADMIN=0x0000000000000000000000000000000000000000
# Final delayed administrator; use a distinct governance multisig.
FINAL_ADMIN=0x0000000000000000000000000000000000000000
MARKET_ADMIN=0x0000000000000000000000000000000000000000
GUARDIAN=0x0000000000000000000000000000000000000000
RESOLUTION_ADMIN=0x0000000000000000000000000000000000000000
# Set RESOLUTION_ADMIN equal to MARKET_ADMIN for the single-operator API workflow.
# Governance, guardian and temporary deployer remain distinct.
USDG_ADDRESS=0x0000000000000000000000000000000000000000

DEPLOY_CONDITIONAL_TOKENS=false
CONDITIONAL_TOKENS_ADDRESS=0x0000000000000000000000000000000000000000

# Required by verify:v2 and market:create after the delayed handover is accepted.
DEPLOYMENT_MANIFEST=
# Optional fresh output directory, e.g. for an isolated local deployment rehearsal.
DEPLOYMENT_OUTPUT_DIRECTORY=

# Manual admin actions default to simulation-only.
SUBMIT_ADMIN_ACTION=false
ADMIN_CALLER_ADDRESS=0x0000000000000000000000000000000000000000
ADMIN_PRIVATE_KEY=
